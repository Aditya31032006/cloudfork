{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudforkReadS3Configuration",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetBucketPolicy",
        "s3:GetBucketCORS",
        "s3:GetBucketTagging",
        "s3:GetLifecycleConfiguration",
        "s3:GetBucketNotification"
      ],
      "Resource": "*"
    }
  ]
}
